{
  "name": "@local/sidebar-pomodoro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adds a Pomodoro button to the sidebar foot that opens a focus-timer page. · 在侧栏底部加一个番茄钟按钮，点击打开专注计时页面。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
