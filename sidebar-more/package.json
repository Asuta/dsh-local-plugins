{
  "name": "@local/sidebar-more",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Keep Plugin Market and More in the sidebar, with Plugins and Automation tasks inside More. · 侧栏只保留插件市场与更多，把插件和自动化任务收进「更多」。",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
